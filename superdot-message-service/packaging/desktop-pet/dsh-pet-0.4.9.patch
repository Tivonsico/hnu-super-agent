+/* SuperDot's work-order bubbles are independent of the native chat and note panels. */
+'use strict';
+
+async function requestSuperdot(path, body) {
+  try {
+    const response = await fetch(BASE + '/superdot/' + path, {
+      cache: 'no-store',
+      signal: AbortSignal.timeout(5000),
+      ...(body && {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify(body),
+      }),
+    });
+    const result = await response.json();
+    if (response.ok || result.ok === false) return result;
+  } catch {
+    // The pet may run on its own or the message service may have stopped.
+  }
+  return { ok: false, message: '联系不到 SuperDot，请确认它已启动后重试。' };
+}
+
+Object.assign(PetSprite.prototype, {
+  mountSuperdot() {
+    if (OPEN_TARGET !== 'standalone' || this.pet.id !== 'main') return;
+    const stack = document.createElement('div');
+    stack.className = 'superdot-pet-stack';
+    stack.hidden = true;
+    stack.setAttribute('role', 'log');
+    stack.setAttribute('aria-label', 'SuperDot 工单提醒');
+    this.superdotStack = stack;
+    this.superdotIgnored = new Set();
+    this.superdotBaseMargin = { ...this.margin };
+    this.superdotSpoken = new Set();
+    this.el.append(stack);
+    const edge = document.createElement('button');
+    edge.type = 'button';
+    edge.className = 'superdot-edge';
+    edge.hidden = true;
+    edge.onclick = () => this.toggleSuperdotDock();
+    this.superdotEdge = edge;
+    document.body.append(edge);
+    const place = () => this.refreshSuperdotBounds();
+    const card = document.createElement('article');
+    card.className = 'superdot-pet-bubble';
+    const text = document.createElement('div');
+    const status = document.createElement('small');
+    status.setAttribute('role', 'status');
+    const actions = document.createElement('div');
+    actions.className = 'superdot-actions';
+    const makeButton = (label, fn) => {
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.textContent = label;
+      button.onclick = fn;
+      return button;
+    };
+    const open = makeButton('前往查看', async () => {
+      open.disabled = true;
+      try { await this.openSuperdot(this.superdotItem.target || 'orders'); }
+      finally { open.disabled = false; }
+    });
+    const ignore = makeButton('暂时忽略', () => {
+      this.superdotIgnored.add(this.superdotItem.id);
+      this.superdotError = '';
+      this.renderSuperdot(this.superdotOnline);
+    });
+    const pager = document.createElement('nav');
+    pager.setAttribute('aria-label', '提醒翻页');
+    const page = document.createElement('span');
+    const turn = (offset) => {
+      const index = this.superdotItems.findIndex(item => item.id === this.superdotItem.id);
+      this.superdotItem = this.superdotItems[index + offset];
+      this.superdotError = '';
+      this.renderSuperdot(this.superdotOnline);
+    };
+    const previous = makeButton('‹', () => turn(-1));
+    const next = makeButton('›', () => turn(1));
+    previous.setAttribute('aria-label', '上一条');
+    next.setAttribute('aria-label', '下一条');
+    pager.append(previous, page, next);
+    actions.append(open, ignore, pager);
+    card.append(text, status, actions);
+    stack.append(card);
+    this.superdotCard = { card, text, status, pager, previous, next, page };
+    this.superdotLayoutObserver = new ResizeObserver(place);
+    this.superdotLayoutObserver.observe(this.bubble);
+    window.addEventListener('resize', place, { signal: this.ac.signal });
+    const poll = async () => {
+      const snapshot = await requestSuperdot('state');
+      if (this.ac.signal.aborted) return;
+      if (snapshot.ok && Array.isArray(snapshot.bubbles)) {
+        const wasActive = this.superdotState?.active;
+        const hadSnapshot = this.superdotState !== undefined;
+        const previousIds = new Set(this.superdotState?.bubbles.map((item) => item.id));
+        this.superdotState = snapshot;
+        this.superdotOnline = true;
+        if (wasActive !== snapshot.active) this.renderBubble();
+        if (!snapshot.active) this.superdotSpoken.clear();
+        for (const item of snapshot.bubbles) {
+          if (snapshot.active && item.speak && !this.superdotSpoken.has(item.id)) {
+            this.superdotSpoken.add(item.id);
+            if (hadSnapshot && !this.sleeping && !this.superdotDock) S.speakNotice(item.text);
+          }
+        }
+        const cue = snapshot.active && snapshot.bubbles.find((item) =>
+          !previousIds.has(item.id) && ((hadSnapshot && ['created', 'result', 'problem'].includes(item.kind)) ||
+            item.id.startsWith('preview:')));
+        if (cue && !this.superdotDock) this.playSuperdotCue(cue.kind);
+      }
+      this.superdotOnline = snapshot.ok === true;
+      this.renderSuperdot(this.superdotOnline);
+      this.superdotTimer = window.setTimeout(poll, 1000);
+    };
+    void poll();
+  },
+
+  playSuperdotCue(kind) {
+    if (this.sleeping || this.frozen || this.dragging || this.chatOpen) return;
+    const events = this.animations?.events?.workStatus;
+    const slot = kind === 'created' ? this.animations?.clicks : events?.[S.WORK_STATUS_INDEX[kind === 'result' ? 'success' : 'error']];
+    if (!slot || (Array.isArray(slot) && !slot.length)) return;
+    const anim = S.pickSlot(slot, this.anim);
+    if (anim) this.playOnce(anim);
+  },
+
+  disposeSuperdot() {
+    window.clearTimeout(this.superdotTimer);
+    window.clearTimeout(this.superdotErrorTimer);
+    this.superdotLayoutObserver?.disconnect();
+    this.superdotEdge?.remove();
+    if (this.superdotDock) {
+      document.body.classList.remove('superdot-folded');
+      S.setVoiceSuspended(false);
+    }
+  },
+
+  async openSuperdot(target) {
+    const result = await requestSuperdot('action', { kind: 'open', target });
+    if (!result.ok) this.showSuperdotError(result.message);
+    return result;
+  },
+
+  showSuperdotError(message) {
+    this.superdotError = message || '无法打开 SuperDot，请稍后重试。';
+    this.renderSuperdot(this.superdotOnline);
+    clearTimeout(this.superdotErrorTimer);
+    this.superdotErrorTimer = setTimeout(() => {
+      this.superdotError = '';
+      this.renderSuperdot(this.superdotOnline);
+    }, 6000);
+  },
+
+  renderSuperdot(isCurrent) {
+    if (!this.superdotCard) return;
+    const snapshot = this.superdotState;
+    const bubbles = snapshot?.active ? snapshot.bubbles : [];
+    const visible = bubbles.filter(item => !this.superdotIgnored.has(item.id) &&
+      (item.kind === 'action' || (!this.sleeping && isCurrent)));
+    const oldIndex = this.superdotItems?.findIndex(item => item.id === this.superdotItem?.id) ?? 0;
+    this.superdotItems = visible;
+    const item = visible.find(item => item.id === this.superdotItem?.id) ||
+      visible[Math.min(Math.max(0, oldIndex), visible.length - 1)];
+    this.superdotItem = item;
+    this.superdotStack.hidden = !item;
+    this.el.classList.toggle('superdot-pet-linked', Boolean(snapshot?.active));
+    if (item) {
+      const { card, text, status, pager, previous, next, page } = this.superdotCard;
+      card.dataset.kind = item.kind;
+      if (text.textContent !== item.text) text.textContent = item.text;
+      status.textContent = this.superdotError || '';
+      status.hidden = !this.superdotError;
+      const index = visible.indexOf(item);
+      pager.hidden = visible.length < 2;
+      previous.disabled = index === 0;
+      next.disabled = index === visible.length - 1;
+      page.textContent = (index + 1) + '/' + visible.length;
+    }
+    this.refreshSuperdotBounds();
+    this.syncInputBusy();
+  },
+
+  nearestSuperdotEdge() {
+    const { x, y } = this.pos;
+    const area = S.resolveRect(WORK_AREAS, x + this.halfW, y + this.halfH);
+    if (!area) return null;
+    const hit = this.hitRect;
+    const distances = {
+      left: x + hit.x - area.x, right: area.x + area.width - x - hit.x - hit.w,
+      top: y + hit.y - area.y, bottom: area.y + area.height - y - hit.y - hit.h,
+    };
+    const side = Object.keys(distances).reduce((a, b) => distances[a] <= distances[b] ? a : b);
+    return { side, area, distance: distances[side] };
+  },
+
+  toggleSuperdotDock() {
+    const edge = this.nearestSuperdotEdge();
+    if (!edge) return;
+    this.stopThrow();
+    this.stopMove();
+    this.closeMenu();
+    this.chatMount?.close();
+    this.closeTodo();
+    this.setTip(false);
+    this.hoverBody = false;
+    this.superdotDock = this.superdotDock ? null : edge.side;
+    document.body.classList.toggle('superdot-folded', !!this.superdotDock);
+    S.setVoiceSuspended(!!this.superdotDock);
+    this.refreshSuperdotBounds();
+    this.syncInputBusy();
+    this.setInteractive(!!this.superdotDock);
+  },
+
+  // A folded pet owns only the native window occupied by the restore handle.
+  reportSuperdotDock() {
+    const edge = this.nearestSuperdotEdge();
+    if (!edge) return;
+    const area = edge.area;
+    const side = this.superdotDock;
+    const vertical = side === 'left' || side === 'right';
+    const w = vertical ? 23 : 44, h = vertical ? 44 : 23;
+    const x = side === 'left' ? area.x : side === 'right' ? area.x + area.width - w :
+      Math.max(area.x, Math.min(this.pos.x + this.halfW - w / 2, area.x + area.width - w));
+    const y = side === 'top' ? area.y : side === 'bottom' ? area.y + area.height - h :
+      Math.max(area.y, Math.min(this.pos.y + this.halfH - h / 2, area.y + area.height - h));
+    this.updateSuperdotEdge(side, true);
+    window.petBridge?.setBounds(toScreen(x + VIEW.x), toScreen(y + VIEW.y), toScreen(w), toScreen(h),
+      toScreen(x), toScreen(y), toScreen(w), 0, 0, 0, 0, 0);
+    this.syncInputRegions();
+  },
+
+  updateSuperdotEdge(side, folded) {
+    const button = this.superdotEdge;
+    const arrows = folded ? { left:'›', right:'‹', top:'⌄', bottom:'⌃' } : { left:'‹', right:'›', top:'⌃', bottom:'⌄' };
+    const label = folded ? '展开桌宠' : '贴边收起';
+    button.hidden = false;
+    button.dataset.side = side;
+    button.textContent = arrows[side];
+    button.title = label;
+    button.setAttribute('aria-label', label);
+  },
+
+  placeSuperdotEdge() {
+    if (!this.superdotEdge || this.superdotDock) return;
+    const edge = this.nearestSuperdotEdge();
+    const area = this.visibleClampRect();
+    const wasHidden = this.superdotEdge.hidden;
+    if (!edge || edge.distance > 64 || !area) {
+      this.superdotEdge.hidden = true;
+      if (!wasHidden) this.syncInputBusy();
+      return;
+    }
+    this.updateSuperdotEdge(edge.side, false);
+    const hit = this.hit.getBoundingClientRect();
+    const x = edge.side === 'left' ? hit.left - 22 : edge.side === 'right' ? hit.right : (hit.left + hit.right)/2 - 11;
+    const y = edge.side === 'top' ? hit.top - 22 : edge.side === 'bottom' ? hit.bottom : (hit.top + hit.bottom)/2 - 11;
+    this.superdotEdge.style.left = Math.max(area.x, Math.min(x, area.x + area.w - 22)) + 'px';
+    this.superdotEdge.style.top = Math.max(area.y, Math.min(y, area.y + area.h - 22)) + 'px';
+    if (wasHidden) this.syncInputBusy();
+    else this.syncInputRegions();
+  },
+
+  refreshSuperdotBounds() {
+    if (this.pos) this.sendBounds(this.pos.x, this.pos.y);
+  },
+
+  // Compute the full card bounds in display coordinates before fitting the transparent Electron window.
+  fitSuperdot() {
+    if (!this.superdotStack || !this.pos) return;
+    const base = this.superdotBaseMargin;
+    const stack = this.superdotStack;
+    if (stack.hidden) { this.margin = base; return; }
+    const screen = S.resolveRect(WORK_AREAS, this.pos.x + this.halfW, this.pos.y + this.halfH);
+    if (!screen) return;
+    const gap = 6;
+    const maxWidth = Math.max(1, screen.width - gap * 2);
+    const hit = this.hitRect;
+    const x = this.pos.x + hit.x + hit.w / 2;
+    const top = this.pos.y + hit.y;
+    const bottom = top + hit.h;
+    let width = Math.min(350, maxWidth);
+    stack.style.width = width + 'px';
+    let height = stack.offsetHeight;
+    const above = top - screen.y - gap;
+    const below = screen.y + screen.height - bottom - gap;
+    if (height > Math.max(above, below) && width < maxWidth) {
+      width = Math.min(maxWidth, Math.max(width, Math.ceil(width * height / Math.max(120, above, below))));
+      stack.style.width = width + 'px';
+      height = stack.offsetHeight;
+    }
+    const belowPet = height > above && below > above;
+    const left = Math.max(screen.x + gap, Math.min(x - width / 2, screen.x + screen.width - width - gap));
+    const y = Math.max(screen.y + gap, Math.min(belowPet ? bottom : top - height, screen.y + screen.height - height - gap));
+    this.margin = {
+      l: Math.max(base.l, Math.ceil(this.pos.x - left)),
+      r: Math.max(base.r, Math.ceil(left + width - this.pos.x - this.size)),
+      t: Math.max(base.t, Math.ceil(this.pos.y - y)),
+      b: Math.max(base.b, Math.ceil(y + height - this.pos.y - this.winH)),
+    };
+    this.superdotBounds = { left, y };
+    stack.classList.toggle('is-below', belowPet);
+    stack.style.setProperty('--superdot-tail', Math.max(16, Math.min(width - 16, x - left)) + 'px');
+  },
+
+  positionSuperdot() {
+    if (!this.superdotBounds || this.superdotStack.hidden) return;
+    this.superdotStack.style.left = (this.superdotBounds.left - this.pos.x + this.winOffset.x) + 'px';
+    this.superdotStack.style.top = (this.superdotBounds.y - this.pos.y + this.winOffset.y) + 'px';
+    this.syncInputRegions();
+  },
+});
