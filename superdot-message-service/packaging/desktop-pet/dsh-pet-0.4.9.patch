diff --git a/dsh-pet/src/standalone/server/superdot.ts b/dsh-pet/src/standalone/server/superdot.ts
new file mode 100644
index 0000000..39ebae5
--- /dev/null
+++ b/dsh-pet/src/standalone/server/superdot.ts
@@ -0,0 +1,69 @@
+import type { IncomingMessage, ServerResponse } from 'node:http';
+import { sendJson } from './respond.ts';
+
+const prefix = '/dsh-pet-7340/superdot/';
+const disconnected = { ok: false, message: 'SuperDot 未连接，请打开 SuperDot 后重试。' };
+let connection: { port: number; key: string } | undefined;
+
+export async function requestSuperdot(segment: 'state' | 'action', body?: string) {
+  const peer = connection;
+  if (!peer) return { status: 503, payload: disconnected };
+  try {
+    const response = await fetch(`http://127.0.0.1:${peer.port}/api/desktop-pet/${segment}`, {
+      method: segment === 'state' ? 'GET' : 'POST',
+      headers: { 'X-SuperDot-Desktop-Pet': peer.key, 'Content-Type': 'application/json' },
+      body: segment === 'action' ? body : undefined,
+      redirect: 'error',
+      signal: AbortSignal.timeout(6000),
+    });
+    return { status: response.status, payload: await response.json() };
+  } catch {
+    return { status: 503, payload: disconnected };
+  }
+}
+
+async function readJson(req: IncomingMessage): Promise<Record<string, unknown> | null> {
+  try {
+    const chunks: Buffer[] = [];
+    let size = 0;
+    for await (const chunk of req) {
+      const data = Buffer.from(chunk);
+      size += data.length;
+      if (size > 8192) return null;
+      chunks.push(data);
+    }
+    const value = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+    return value && typeof value === 'object' && !Array.isArray(value) ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function handleSuperdot(req: IncomingMessage, res: ServerResponse, pathname: string) {
+    const segment = pathname.slice(prefix.length);
+    const method = req.method;
+    if (segment === 'connect' && method === 'POST') {
+      const packet = await readJson(req);
+      const port = packet?.port;
+      const key = packet?.key;
+      if (typeof port !== 'number' || !Number.isInteger(port) || port < 1 || port > 65535 ||
+          typeof key !== 'string' || !/^[A-Za-z0-9_-]{43}$/.test(key)) {
+        sendJson(res, 400, { ok: false, message: 'SuperDot 本机连接参数无效。' });
+        return;
+      }
+      connection = { port, key };
+      sendJson(res, 200, { ok: true });
+      return;
+    }
+    if ((segment !== 'state' || method !== 'GET') && (segment !== 'action' || method !== 'POST')) {
+      sendJson(res, 404, { ok: false, message: '桌宠操作不存在。' });
+      return;
+    }
+    const body = method === 'POST' ? await readJson(req) : undefined;
+    if (body === null) {
+      sendJson(res, 400, { ok: false, message: '桌宠操作内容无效。' });
+      return;
+    }
+    const { status, payload } = await requestSuperdot(segment, body ? JSON.stringify(body) : undefined);
+    sendJson(res, status, payload);
+}
