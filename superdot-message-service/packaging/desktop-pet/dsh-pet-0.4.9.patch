@@ -0,0 +1,77 @@
+.superdot-pet-stack {
+  position: fixed;
+  z-index: 5;
+  box-sizing: border-box;
+  padding: 5px 5px 8px;
+
+  color: #273953;
+  font: 13px/1.45 system-ui, sans-serif;
+  pointer-events: auto;
+}
+.superdot-pet-stack[hidden] { display: none; }
+.superdot-pet-stack [hidden] { display: none; }
+.superdot-pet-bubble > div:first-child { white-space: pre-wrap; }
