+.superdot-actions button { margin-block-start: 0; }
+.superdot-pet-bubble nav { margin-inline-start: auto; gap: 4px; font-variant-numeric: tabular-nums; }
+.superdot-pet-bubble button:disabled { opacity: .5; }
+.superdot-pet-bubble nav button { min-width: 30px; }
+.superdot-pet-bubble {
+  position: relative;
+  flex: 0 0 auto;
+  margin-inline: 2px;
+  padding: 8px 11px;
+  border: 1px solid #d5dfed;
+  border-radius: 12px;
+  background: #fbfdff;
+  box-shadow: 0 2px 6px #18253b2b;
+  overflow-wrap: anywhere;
+}
+.superdot-pet-bubble:first-child::after {
+  position: absolute;
+  bottom: -5px;
+  left: calc(var(--superdot-tail, 50%) - 9px);
+  width: 8px;
+  height: 8px;
+  border-right: 1px solid #d5dfed;
+  border-bottom: 1px solid #d5dfed;
+  background: inherit;
+  content: '';
+  transform: rotate(45deg);
+  pointer-events: none;
+}
+.superdot-pet-stack.is-below .superdot-pet-bubble:first-child::after {
+  inset-block: -5px auto;
+  transform: rotate(225deg);
+}
+.superdot-pet-bubble[data-kind="action"] {
+  border-color: #adbfdd;
+  background: #f0f5fd;
+}
+.superdot-pet-bubble[data-kind="problem"] {
+  border-color: #e1b7ac;
+  background: #fff8f5;
+}
+.superdot-pet-bubble button,
+.dsh-pet-todo .superdot-note-submit {
+  margin-top: 0;
+  padding: 3px 7px;
+  border: 1px solid #bac9e1;
+  border-radius: 5px;
+  background: #fff;
+  color: #284c81;
+  font: inherit;
+  cursor: pointer;
+}
+.superdot-pet-bubble button:focus-visible,
+.dsh-pet-todo .superdot-note-submit:focus-visible { outline: 2px solid #315a9a; }
+.dsh-pet-todo .superdot-note-submit { font-size: .846em; }
+
+.superdot-edge {
+  box-sizing: border-box; position: fixed; z-index: 9; width: 22px; height: 22px;
+  border: 1px solid #a6bad6; border-radius: 8px; background: #f5f9ff; color: #294b77;
+  font: 18px/1 system-ui,sans-serif; padding: 0; cursor: pointer; pointer-events: auto;
+}
+.superdot-edge[hidden], body.superdot-folded > :not(.superdot-edge) { display: none !important; }
+body.superdot-folded > .superdot-edge { inset: 0 !important; width: 100%; height: 100%; }
