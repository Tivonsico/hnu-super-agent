# 环境变量统一用 NOTICEHUB_ 前缀；旧名 QQ_DIGEST_* 仍可读，新名优先。
# ===== 大模型与推送通道建议在网页里配，不用手改这个文件 =====
# 打开页面右上角「设置」：「AI API Key 配置」挑服务商、填写密钥、保存配置；
# 「提醒怎么送到手机」照着 1-2-3 步填通道、点「发一条测试消息」。两者都会写回同目录 .env。
# 下面这份模板是给手工配置、或想用下拉里没有的服务商时看的。

# ===== 官方 QQ 机器人（可选，默认关闭；当前主链路用 NapCat/OneBot）=====
# 设为 1 才启用官方 QQ 机器人；当前部署使用 NapCat，保持 0 即可。
NOTICEHUB_OFFICIAL_BOT_ENABLED=0
QQ_BOT_APPID=
QQ_BOT_SECRET=
# 沙箱环境填 1，正式环境填 0
QQ_BOT_SANDBOX=1
# 只监听这几个群（NapCat 填 QQ 群号；官方 Bot 填 group_openid，逗号分隔）
# 必填：留空 = 不处理任何群（fail-closed），不会默认接收全部群。
# 示例：NOTICEHUB_GROUPS=123456789,987654321
NOTICEHUB_GROUPS=
# 要订阅的 QQ 私聊账号，逗号分隔。
NOTICEHUB_QQ_PRIVATE_IDS=
# 群号/openid 到中文名的映射，便于阅读：123456=学院通知群,789012=班级群
NOTICEHUB_GROUP_ALIASES=
# 低优先级/闲聊群（群号或 openid，逗号分隔）：不触发紧急立即推，普通讨论不入摘要/待办
NOTICEHUB_QUIET_GROUPS=
# 即时处理群（群号或 openid，逗号分隔）：不等合并窗口，来消息后下一轮直接处理，适合测试群
NOTICEHUB_IMMEDIATE_GROUPS=
# 推送目标：先私聊机器人一次，把日志里 C2C_MESSAGE_CREATE 的 user_openid 填进来
NOTICEHUB_PUSH_OPENIDS=

# ===== 备用推送通道（QQ 私聊失败时自动回退，至少配一个）=====
# WxPusher：https://wxpusher.zjiecode.com/docs/ （微信接收）
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=
WXPUSHER_TOPIC_IDS=
# Server酱：https://sct.ftqq.com/ （微信接收）
SERVERCHAN_KEYS=
# PushPlus：https://www.pushplus.plus/ （支持 QQ 机器人通道）
PUSHPLUS_TOKENS=
# 通用 Webhook（POST JSON: title/content/source）
NOTICEHUB_WEBHOOKS=

# ===== SuperDot API 配置（可在群务台设置页保存）=====
NOTICEHUB_LLM_API_KEY=
NOTICEHUB_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
NOTICEHUB_LLM_MODEL=deepseek-flash
NOTICEHUB_LLM=1

# 推送里是否附带原文；0=只发本地精简摘要
NOTICEHUB_INCLUDE_RAW=0

# 推送卡片：HTML 色块突出待办/紧急，通知栏用一句话摘要
NOTICEHUB_PUSH_HTML=1
# 推送预算与夜间静默：非紧急推送统一限流，紧急事项始终放行。
# 预算设为 0 表示不限量；静默时段留空表示关闭。
NOTICEHUB_PUSH_DAILY_BUDGET=12
NOTICEHUB_QUIET_HOURS=23:00-07:00
# 截止提醒：早上看今天到期，晚上提前看明天到期
NOTICEHUB_DEADLINE_REMINDERS=1
NOTICEHUB_DEADLINE_MORNING=07:30
NOTICEHUB_DEADLINE_EVENING=21:00

# 候选确认与每周复盘：模糊的行动项先问你确认，每周复盘一次
NOTICEHUB_CANDIDATE_PUSH=1
NOTICEHUB_CANDIDATE_MIN_CONFIDENCE=0.55
NOTICEHUB_CANDIDATE_REMINDER_HOURS=24
NOTICEHUB_CANDIDATE_MAX_PER_TICK=2
NOTICEHUB_CANDIDATE_MAX_PER_DAY=4
NOTICEHUB_WEEKLY_REVIEW=1
# Python weekday: 0=周一, 6=周日
NOTICEHUB_WEEKLY_REVIEW_WEEKDAY=6
NOTICEHUB_WEEKLY_REVIEW_TIME=20:30

# 手机端待办台：Tailscale 或局域网访问；token 留空会自动生成
NOTICEHUB_WEB=1
NOTICEHUB_WEB_HOST=0.0.0.0
NOTICEHUB_WEB_PORT=8766
# 可选：固定外部访问地址，例如 Tailscale Serve 的 HTTPS 地址
# NOTICEHUB_WEB_BASE_URL=https://your-machine.your-tailnet.ts.net
NOTICEHUB_WEB_TOKEN=

# ===== 调度参数 =====
# 普通通知合并窗口（分钟）
NOTICEHUB_WINDOW_MINUTES=30
# 轮询间隔（秒）
NOTICEHUB_POLL_SECONDS=20
# 单批最多处理多少条消息
NOTICEHUB_MAX_BATCH=400
# 紧急通知是否立即推送
NOTICEHUB_URGENT_IMMEDIATE=1
# 分数阈值：越高越只推重要通知（建议 3）
NOTICEHUB_MIN_SCORE=3
NOTICEHUB_MAX_ITEMS=30
# 投递失败重试
NOTICEHUB_MAX_ATTEMPTS=4
NOTICEHUB_RETRY_SECONDS=90
NOTICEHUB_RETENTION_DAYS=30

# ===== 主方案：NapCat/LLOneBot 的 OneBot v11 HTTP 上报 =====
NOTICEHUB_ONEBOT_ENABLED=1
NOTICEHUB_ONEBOT_HOST=127.0.0.1
NOTICEHUB_ONEBOT_PORT=8765
NOTICEHUB_ONEBOT_TOKEN=

# Framework OneBot HTTP 服务（读取 QQ 会话和历史消息）
NOTICEHUB_NAPCAT_API_URL=http://127.0.0.1:3001
NOTICEHUB_NAPCAT_API_TOKEN=
# Framework 接口请求超时（秒）
NOTICEHUB_HTTP_TIMEOUT=15

# 历史补采：服务启动时及每隔 N 分钟，从 NapCat 拉取最近消息补齐断点
NOTICEHUB_CATCHUP_ENABLED=1
NOTICEHUB_CATCHUP_HOURS=24
NOTICEHUB_CATCHUP_COUNT=50
NOTICEHUB_CATCHUP_INTERVAL_MINUTES=30

# 数据与日志目录（默认项目下 data/ 和 logs/）
NOTICEHUB_DATA_DIR=
NOTICEHUB_LOG_DIR=

# 群文件 / 群图片：保留附件并提取可读取的文档文本
NOTICEHUB_ATTACHMENTS=1
NOTICEHUB_ATTACHMENT_MAX_MB=10
NOTICEHUB_ATTACHMENT_MAX_PER_HOUR=30
NOTICEHUB_ATTACHMENT_RETENTION_DAYS=7
NOTICEHUB_DOCUMENT_MAX_CHARS=30000
# 多少小时内推过的同一条通知不再重复推（班级群/闲聊群转发重复），0=关闭
NOTICEHUB_DEDUPE_HOURS=6

# ===== 托管：让 NapCat 和你的电脑版 QQ 共用一台电脑 =====
# 背景：同一个 QQ 号不能在两个电脑端同时在线（腾讯服务端规则）。
# 「开始托管」= 先关掉电脑版 QQ，再启动 NapCat（用独立资料目录，不读也不动你本来的 QQ 数据）；
# 「结束托管」= 停掉 NapCat，并把电脑版 QQ 开回来。
# 0=关闭 1=开启。网页「设置」里的四个勾选项改的就是这四行。
NOTICEHUB_HOSTING_QUIT_QQ=1
NOTICEHUB_HOSTING_RESTORE_QQ=1
# 软件一启动就自动开始托管
NOTICEHUB_HOSTING_AUTO_ON_START=0
# 开机自动启动群务台（只写当前用户的开机启动项，不需要管理员）
NOTICEHUB_AUTOSTART=0

# 执行宿主的 HTTP(S) 源地址。留空时，消息包只在本地排队。
# 留空由 main.py run 在 127.0.0.1:18765 启动并复用项目 DSH；填地址则使用指定宿主。
NOTICEHUB_EXECUTION_URL=
# 执行宿主启用了 Bearer 鉴权时填写。
NOTICEHUB_EXECUTION_TOKEN=
# 执行宿主的 <superdot> 目录。同机共享该目录时填写，可下载已发布成果。
NOTICEHUB_EXECUTION_DATA_ROOT=

# 桌宠默认从 dsh-pet 独立版运行文件读本机端口。仅在自定义部署时填写。
NOTICEHUB_DESKTOP_PET_URL=
NOTICEHUB_DESKTOP_PET_RUNTIME=
